[Unit]
Description=ZynSimple DJ-Pult: Stems im Hintergrund vorbereiten (pausiert beim Auflegen)
After=network.target

[Service]
ExecStart=/usr/bin/python3 /zynthian/zynthian-my-data/zynsimple/dj/stems-arbeiter.py
Nice=19
IOSchedulingClass=idle
CPUWeight=5
MemoryHigh=2500M
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
