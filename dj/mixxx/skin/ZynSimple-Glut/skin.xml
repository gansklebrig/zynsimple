<!DOCTYPE skin>
<!--
  ZynSimple Glut – kompakte Mixxx-Ansicht für das 5-Zoll-Display des Zynthian (800 × 480).
  Warme Farben ohne Blau: Bässe rot, Mitten gold, Höhen grün.
  Oben die beiden Decks (Titel, Zeit, Tempo, Tonart), darunter die Wellenformen, unten die Bibliothek.
-->
<skin>
  <manifest>
    <title>ZynSimple Glut</title>
    <author>ZynSimple</author>
    <version>1.0</version>
    <description>Kompakte Ansicht für den Zynthian V5 (800 × 480), ohne Blau</description>
    <language>de</language>
    <license>GPL-2.0-or-later</license>
    <attributes>
      <attribute config_key="[Master],num_decks">2</attribute>
      <attribute config_key="[Master],num_samplers">4</attribute>
      <attribute config_key="[Master],num_microphones">0</attribute>
      <attribute config_key="[Master],num_auxiliaries">1</attribute>
      <attribute config_key="[Skin],show_maximized_library">0</attribute>
    </attributes>
  </manifest>
  <ObjectName>Mixxx</ObjectName>
  <BgColor>#100e0d</BgColor>
  <Style src="skin:style.qss"/>
  <MinimumSize>780,420</MinimumSize>
  <SizePolicy>me,me</SizePolicy>
  <Layout>vertical</Layout>
  <Children>

    <!-- Decks: Titel, Zeit, Tempo, Tonart -->
    <WidgetGroup>
      <ObjectName>DeckReihe</ObjectName>
      <Layout>horizontal</Layout>
      <SizePolicy>me,min</SizePolicy>
      <Connection>
        <ConfigKey>[Skin],show_maximized_library</ConfigKey>
        <Transform><Not/></Transform>
        <BindProperty>visible</BindProperty>
      </Connection>
      <Children>
        <WidgetGroup>
          <ObjectName>Deck1</ObjectName>
          <Layout>vertical</Layout>
          <SizePolicy>me,min</SizePolicy>
          <Children>
            <WidgetGroup>
              <Layout>horizontal</Layout>
              <SizePolicy>me,min</SizePolicy>
              <Children>
                <PushButton>
                  <ObjectName>PlayAnzeige</ObjectName>
                  <Size>26f,22f</Size>
                  <NumberStates>2</NumberStates>
                  <State><Number>0</Number><Text>▶</Text></State>
                  <State><Number>1</Number><Text>❚❚</Text></State>
                  <Connection><ConfigKey>[Channel1],play</ConfigKey></Connection>
                </PushButton>
                <Label>
                  <ObjectName>DeckName</ObjectName>
                  <Text>A</Text>
                  <Size>16f,22f</Size>
                </Label>
                <TrackProperty>
                  <ObjectName>Titel</ObjectName>
                  <Channel>1</Channel>
                  <Property>titleInfo</Property>
                  <SizePolicy>me,min</SizePolicy>
                </TrackProperty>
              </Children>
            </WidgetGroup>
            <WidgetGroup>
              <Layout>horizontal</Layout>
              <SizePolicy>me,min</SizePolicy>
              <Children>
                <NumberPos>
                  <ObjectName>Zeit</ObjectName>
                  <Channel>1</Channel>
                  <NumberOfDigits>6</NumberOfDigits>
                  <SizePolicy>me,min</SizePolicy>
                  <Connection><ConfigKey>[Channel1],playposition</ConfigKey></Connection>
                </NumberPos>
                <Number>
                  <ObjectName>Tempo</ObjectName>
                  <Channel>1</Channel>
                  <NumberOfDigits>1</NumberOfDigits>
                  <SizePolicy>min,min</SizePolicy>
                  <Connection><ConfigKey>[Channel1],visual_bpm</ConfigKey></Connection>
                </Number>
                <Key>
                  <ObjectName>Tonart</ObjectName>
                  <Channel>1</Channel>
                  <SizePolicy>min,min</SizePolicy>
                  <Connection><ConfigKey>[Channel1],visual_key</ConfigKey></Connection>
                </Key>
              </Children>
            </WidgetGroup>
            <WidgetGroup>
              <ObjectName>StemReihe</ObjectName>
              <Layout>horizontal</Layout>
              <SizePolicy>me,min</SizePolicy>
              <Connection>
                <ConfigKey>[Channel1],stem_count</ConfigKey>
                <BindProperty>visible</BindProperty>
              </Connection>
              <Children>
                    <PushButton>
                      <ObjectName>StemDrums</ObjectName>
                      <Size>54f,22f</Size>
                      <NumberStates>2</NumberStates>
                      <State><Number>0</Number><Text>Drums</Text></State>
                      <State><Number>1</Number><Text>Drums</Text></State>
                      <Connection><ConfigKey>[Channel1_Stem1],mute</ConfigKey></Connection>
                    </PushButton>
                    <PushButton>
                      <ObjectName>StemBass</ObjectName>
                      <Size>54f,22f</Size>
                      <NumberStates>2</NumberStates>
                      <State><Number>0</Number><Text>Bass</Text></State>
                      <State><Number>1</Number><Text>Bass</Text></State>
                      <Connection><ConfigKey>[Channel1_Stem2],mute</ConfigKey></Connection>
                    </PushButton>
                    <PushButton>
                      <ObjectName>StemMelodie</ObjectName>
                      <Size>54f,22f</Size>
                      <NumberStates>2</NumberStates>
                      <State><Number>0</Number><Text>Melodie</Text></State>
                      <State><Number>1</Number><Text>Melodie</Text></State>
                      <Connection><ConfigKey>[Channel1_Stem3],mute</ConfigKey></Connection>
                    </PushButton>
                    <PushButton>
                      <ObjectName>StemVocals</ObjectName>
                      <Size>54f,22f</Size>
                      <NumberStates>2</NumberStates>
                      <State><Number>0</Number><Text>Vocals</Text></State>
                      <State><Number>1</Number><Text>Vocals</Text></State>
                      <Connection><ConfigKey>[Channel1_Stem4],mute</ConfigKey></Connection>
                    </PushButton>
              </Children>
            </WidgetGroup>
          </Children>
        </WidgetGroup>

        <WidgetGroup>
          <ObjectName>Deck2</ObjectName>
          <Layout>vertical</Layout>
          <SizePolicy>me,min</SizePolicy>
          <Children>
            <WidgetGroup>
              <Layout>horizontal</Layout>
              <SizePolicy>me,min</SizePolicy>
              <Children>
                <PushButton>
                  <ObjectName>PlayAnzeige</ObjectName>
                  <Size>26f,22f</Size>
                  <NumberStates>2</NumberStates>
                  <State><Number>0</Number><Text>▶</Text></State>
                  <State><Number>1</Number><Text>❚❚</Text></State>
                  <Connection><ConfigKey>[Channel2],play</ConfigKey></Connection>
                </PushButton>
                <Label>
                  <ObjectName>DeckName</ObjectName>
                  <Text>B</Text>
                  <Size>16f,22f</Size>
                </Label>
                <TrackProperty>
                  <ObjectName>Titel</ObjectName>
                  <Channel>2</Channel>
                  <Property>titleInfo</Property>
                  <SizePolicy>me,min</SizePolicy>
                </TrackProperty>
              </Children>
            </WidgetGroup>
            <WidgetGroup>
              <Layout>horizontal</Layout>
              <SizePolicy>me,min</SizePolicy>
              <Children>
                <NumberPos>
                  <ObjectName>Zeit</ObjectName>
                  <Channel>2</Channel>
                  <NumberOfDigits>6</NumberOfDigits>
                  <SizePolicy>me,min</SizePolicy>
                  <Connection><ConfigKey>[Channel2],playposition</ConfigKey></Connection>
                </NumberPos>
                <Number>
                  <ObjectName>Tempo</ObjectName>
                  <Channel>2</Channel>
                  <NumberOfDigits>1</NumberOfDigits>
                  <SizePolicy>min,min</SizePolicy>
                  <Connection><ConfigKey>[Channel2],visual_bpm</ConfigKey></Connection>
                </Number>
                <Key>
                  <ObjectName>Tonart</ObjectName>
                  <Channel>2</Channel>
                  <SizePolicy>min,min</SizePolicy>
                  <Connection><ConfigKey>[Channel2],visual_key</ConfigKey></Connection>
                </Key>
              </Children>
            </WidgetGroup>
            <WidgetGroup>
              <ObjectName>StemReihe</ObjectName>
              <Layout>horizontal</Layout>
              <SizePolicy>me,min</SizePolicy>
              <Connection>
                <ConfigKey>[Channel2],stem_count</ConfigKey>
                <BindProperty>visible</BindProperty>
              </Connection>
              <Children>
                    <PushButton>
                      <ObjectName>StemDrums</ObjectName>
                      <Size>54f,22f</Size>
                      <NumberStates>2</NumberStates>
                      <State><Number>0</Number><Text>Drums</Text></State>
                      <State><Number>1</Number><Text>Drums</Text></State>
                      <Connection><ConfigKey>[Channel2_Stem1],mute</ConfigKey></Connection>
                    </PushButton>
                    <PushButton>
                      <ObjectName>StemBass</ObjectName>
                      <Size>54f,22f</Size>
                      <NumberStates>2</NumberStates>
                      <State><Number>0</Number><Text>Bass</Text></State>
                      <State><Number>1</Number><Text>Bass</Text></State>
                      <Connection><ConfigKey>[Channel2_Stem2],mute</ConfigKey></Connection>
                    </PushButton>
                    <PushButton>
                      <ObjectName>StemMelodie</ObjectName>
                      <Size>54f,22f</Size>
                      <NumberStates>2</NumberStates>
                      <State><Number>0</Number><Text>Melodie</Text></State>
                      <State><Number>1</Number><Text>Melodie</Text></State>
                      <Connection><ConfigKey>[Channel2_Stem3],mute</ConfigKey></Connection>
                    </PushButton>
                    <PushButton>
                      <ObjectName>StemVocals</ObjectName>
                      <Size>54f,22f</Size>
                      <NumberStates>2</NumberStates>
                      <State><Number>0</Number><Text>Vocals</Text></State>
                      <State><Number>1</Number><Text>Vocals</Text></State>
                      <Connection><ConfigKey>[Channel2_Stem4],mute</ConfigKey></Connection>
                    </PushButton>
              </Children>
            </WidgetGroup>
          </Children>
        </WidgetGroup>
        <!-- Platz für den ☰-Knopf oben rechts -->
        <WidgetGroup>
          <ObjectName>KnopfPlatz</ObjectName>
          <Size>98f,40f</Size>
          <Layout>horizontal</Layout>
          <Children/>
        </WidgetGroup>
      </Children>
    </WidgetGroup>

    <!-- Wellenformen: Bässe rot, Mitten gold, Höhen grün -->
    <WidgetGroup>
      <ObjectName>Wellen</ObjectName>
      <Layout>vertical</Layout>
      <SizePolicy>me,me</SizePolicy>
      <Connection>
        <ConfigKey>[Skin],show_maximized_library</ConfigKey>
        <Transform><Not/></Transform>
        <BindProperty>visible</BindProperty>
      </Connection>
      <Children>
        <Visual>
          <Channel>1</Channel>
          <SizePolicy>me,me</SizePolicy>
          <MinimumSize>200,50</MinimumSize>
          <BgColor>#100e0d</BgColor>
          <SignalColor>#e8b04a</SignalColor>
          <SignalLowColor>#e0445e</SignalLowColor>
          <SignalMidColor>#e8b04a</SignalMidColor>
          <SignalHighColor>#34c78a</SignalHighColor>
          <SignalRGBLowColor>#e0445e</SignalRGBLowColor>
          <SignalRGBMidColor>#e8b04a</SignalRGBMidColor>
          <SignalRGBHighColor>#34c78a</SignalRGBHighColor>
          <BeatColor>#5a4524</BeatColor>
          <AxesColor>#2e261f</AxesColor>
          <PlayPosColor>#f3e9d8</PlayPosColor>
          <EndOfTrackColor>#e0445e</EndOfTrackColor>
          <DefaultMark>
            <Align>bottom|right</Align>
            <Color>#e8b04a</Color>
            <TextColor>#000000</TextColor>
            <Text> %1 </Text>
          </DefaultMark>
          <Mark>
            <Control>cue_point</Control>
            <Text>CUE</Text>
            <Align>top|right</Align>
            <Color>#f5d48a</Color>
            <TextColor>#000000</TextColor>
          </Mark>
        </Visual>
        <Visual>
          <Channel>2</Channel>
          <SizePolicy>me,me</SizePolicy>
          <MinimumSize>200,50</MinimumSize>
          <BgColor>#100e0d</BgColor>
          <SignalColor>#e8b04a</SignalColor>
          <SignalLowColor>#e0445e</SignalLowColor>
          <SignalMidColor>#e8b04a</SignalMidColor>
          <SignalHighColor>#34c78a</SignalHighColor>
          <SignalRGBLowColor>#e0445e</SignalRGBLowColor>
          <SignalRGBMidColor>#e8b04a</SignalRGBMidColor>
          <SignalRGBHighColor>#34c78a</SignalRGBHighColor>
          <BeatColor>#5a4524</BeatColor>
          <AxesColor>#2e261f</AxesColor>
          <PlayPosColor>#f3e9d8</PlayPosColor>
          <EndOfTrackColor>#e0445e</EndOfTrackColor>
          <DefaultMark>
            <Align>bottom|right</Align>
            <Color>#e8b04a</Color>
            <TextColor>#000000</TextColor>
            <Text> %1 </Text>
          </DefaultMark>
          <Mark>
            <Control>cue_point</Control>
            <Text>CUE</Text>
            <Align>top|right</Align>
            <Color>#f5d48a</Color>
            <TextColor>#000000</TextColor>
          </Mark>
        </Visual>
        <WidgetGroup>
          <Layout>horizontal</Layout>
          <SizePolicy>me,f</SizePolicy>
          <Size>0me,28f</Size>
          <Children>
            <Overview>
              <Channel>1</Channel>
              <SizePolicy>me,me</SizePolicy>
              <BgColor>#16120f</BgColor>
              <SignalColor>#e8b04a</SignalColor>
              <SignalLowColor>#e0445e</SignalLowColor>
              <SignalMidColor>#e8b04a</SignalMidColor>
              <SignalHighColor>#34c78a</SignalHighColor>
              <SignalRGBLowColor>#e0445e</SignalRGBLowColor>
              <SignalRGBMidColor>#e8b04a</SignalRGBMidColor>
              <SignalRGBHighColor>#34c78a</SignalRGBHighColor>
              <PlayPosColor>#f3e9d8</PlayPosColor>
              <EndOfTrackColor>#e0445e</EndOfTrackColor>
              <Connection><ConfigKey>[Channel1],playposition</ConfigKey></Connection>
            </Overview>
            <Overview>
              <Channel>2</Channel>
              <SizePolicy>me,me</SizePolicy>
              <BgColor>#16120f</BgColor>
              <SignalColor>#e8b04a</SignalColor>
              <SignalLowColor>#e0445e</SignalLowColor>
              <SignalMidColor>#e8b04a</SignalMidColor>
              <SignalHighColor>#34c78a</SignalHighColor>
              <SignalRGBLowColor>#e0445e</SignalRGBLowColor>
              <SignalRGBMidColor>#e8b04a</SignalRGBMidColor>
              <SignalRGBHighColor>#34c78a</SignalRGBHighColor>
              <PlayPosColor>#f3e9d8</PlayPosColor>
              <EndOfTrackColor>#e0445e</EndOfTrackColor>
              <Connection><ConfigKey>[Channel2],playposition</ConfigKey></Connection>
            </Overview>
          </Children>
        </WidgetGroup>
      </Children>
    </WidgetGroup>

    <!-- Bibliothek: Seitenleiste (Kisten, Auto-DJ, Ordner) und Trackliste -->
    <WidgetGroup>
      <ObjectName>BibliothekKopf</ObjectName>
      <Layout>horizontal</Layout>
      <SizePolicy>me,min</SizePolicy>
      <Children>
        <SearchBox>
          <SizePolicy>me,min</SizePolicy>
        </SearchBox>
        <PushButton>
          <ObjectName>GrossKnopf</ObjectName>
          <Size>90f,26f</Size>
          <NumberStates>2</NumberStates>
          <State><Number>0</Number><Text>⤢ groß</Text></State>
          <State><Number>1</Number><Text>⤡ klein</Text></State>
          <Connection><ConfigKey>[Skin],show_maximized_library</ConfigKey></Connection>
        </PushButton>
      </Children>
    </WidgetGroup>
    <WidgetGroup>
      <ObjectName>Bibliothek</ObjectName>
      <Layout>horizontal</Layout>
      <SizePolicy>me,me</SizePolicy>
      <MinimumSize>300,120</MinimumSize>
      <Children>
        <LibrarySidebar>
          <SizePolicy>f,me</SizePolicy>
          <Size>190f,0me</Size>
        </LibrarySidebar>
        <Library>
          <SizePolicy>me,me</SizePolicy>
          <ShowButtonText>false</ShowButtonText>
        </Library>
      </Children>
    </WidgetGroup>

  </Children>
</skin>
